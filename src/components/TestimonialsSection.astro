---
/**
 * TestimonialsSection.astro — Homepage client testimonials section.
 * Features verified reviews from real client projects: Doctor Destiny,
 * Lum Al Kareem, AI RAG & GCP integration, and Tailoring CRM.
 */
import { testimonials, clientBadges } from '@/data/testimonials';

interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Built for founders who demand excellence.",
  subtitle = "From medical education platforms and luxury e-commerce to GCP-powered AI and custom inventory CRMs — here is what our clients say.",
} = Astro.props;

// Schema.org Review structured data
const reviewsJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: testimonials.map((t, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Review',
      author: {
        '@type': 'Person',
        name: t.name,
        jobTitle: t.role,
      },
      itemReviewed: {
        '@type': 'Organization',
        name: 'Moggstack Technologies',
      },
      reviewRating: {
        '@type': 'Rating',
        ratingValue: t.rating,
        bestRating: 5,
      },
      reviewBody: t.content,
    },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(reviewsJsonLd)} />

<section class="section testimonials-section" id="testimonials" aria-labelledby="testimonials-heading">
  <div class="container">
    <div class="section-header" data-reveal>
      <div class="header-badge-row">
        <span class="eyebrow">Client Feedback</span>
        <span class="verified-pill">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          100% Client Satisfaction
        </span>
      </div>
      <h2 id="testimonials-heading" style="margin-top: 0.75rem; margin-bottom: 1rem;">
        What our clients<br/><em>say about us.</em>
      </h2>
      <p style="max-width: 58ch; color: var(--color-muted); line-height: 1.65;">
        {subtitle}
      </p>
    </div>

    <!-- Client badges marquee-like mini strip -->
    <div class="client-tags-strip" data-reveal data-reveal-delay="100">
      <span class="client-tags-label">Featured Projects:</span>
      <div class="client-tags-list">
        {clientBadges.map((badge) => (
          <div class="client-tag-item">
            <span class="client-tag-dot" aria-hidden="true"></span>
            <strong>{badge.name}</strong>
            <span class="client-tag-category">({badge.category})</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Testimonials 2x2 Bento Grid -->
    <div class="testimonials-grid">
      {testimonials.map((t, i) => (
        <article
          class="testimonial-card card-spotlight"
          style={`--card-accent: ${t.accentColor || 'var(--color-accent)'};`}
          data-reveal
          data-reveal-delay={String((i % 2) * 150)}
        >
          <!-- Watermark Quote -->
          <svg class="watermark-quote" width="96" height="96" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
          </svg>

          <!-- Card Header: Rating + Category Tag -->
          <div class="card-meta-header">
            <div class="rating-stars" aria-label={`Rating: ${t.rating} out of 5 stars`}>
              {Array.from({ length: t.rating }).map(() => (
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              ))}
            </div>

            <span class="service-pill">{t.serviceCategory}</span>
          </div>

          <!-- Highlight Metric / Key takeaway -->
          {t.highlight && (
            <div class="highlight-bar">
              <span class="highlight-icon" aria-hidden="true">⚡</span>
              <span class="highlight-text">{t.highlight}</span>
            </div>
          )}

          <!-- Testimonial Quote -->
          <blockquote class="testimonial-body">
            <p>"{t.content}"</p>
          </blockquote>

          <!-- Author Info -->
          <footer class="testimonial-author">
            <div
              class="author-avatar"
              style={`background: color-mix(in srgb, ${t.accentColor || 'var(--color-accent)'} 16%, transparent); color: ${t.accentColor || 'var(--color-accent)'};`}
              aria-hidden="true"
            >
              <span>{t.avatarInitials}</span>
            </div>
            <div class="author-details">
              <cite class="author-name">{t.name}</cite>
              <div class="author-role">
                <span>{t.role}</span>
                <span class="dot-separator">•</span>
                <span class="author-company">{t.company}</span>
              </div>
              <div class="project-line">
                <span class="project-label">Platform:</span> {t.project}
              </div>
            </div>
          </footer>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonials-section {
    background: var(--color-bg);
    position: relative;
    overflow: hidden;
  }

  .header-badge-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }

  .verified-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.65rem;
    background: rgba(40, 200, 64, 0.1);
    color: #28C840;
    border: 1px solid rgba(40, 200, 64, 0.25);
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    font-weight: 500;
  }

  .client-tags-strip {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2.5rem;
    padding: 0.75rem 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow-x: auto;
  }

  .client-tags-label {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .client-tags-list {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .client-tag-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-xs);
    color: var(--color-ink);
    white-space: nowrap;
  }

  .client-tag-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .client-tag-category {
    color: var(--color-muted);
  }

  /* Grid */
  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .testimonial-card {
    position: relative;
    padding: 2.25rem;
    background: var(--gradient-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
    overflow: hidden;
  }

  .testimonial-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.06);
    border-color: color-mix(in srgb, var(--card-accent) 40%, var(--color-border));
  }

  .watermark-quote {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    color: var(--color-ink);
    opacity: 0.04;
    pointer-events: none;
    transition: opacity var(--transition-base);
  }

  .testimonial-card:hover .watermark-quote {
    opacity: 0.08;
  }

  .card-meta-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .rating-stars {
    display: flex;
    gap: 3px;
    color: #F59E0B;
  }

  .service-pill {
    display: inline-block;
    padding: 0.25rem 0.65rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    font-size: 11px;
    font-family: var(--font-mono);
    color: var(--color-muted);
    letter-spacing: -0.01em;
  }

  .highlight-bar {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.85rem;
    background: color-mix(in srgb, var(--card-accent) 8%, var(--color-surface));
    border: 1px solid color-mix(in srgb, var(--card-accent) 20%, transparent);
    border-left: 3px solid var(--card-accent);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    margin-bottom: 1.25rem;
    font-size: var(--text-xs);
    font-family: var(--font-sans);
    color: var(--color-ink);
    font-weight: 500;
  }

  .highlight-icon {
    font-size: 13px;
    line-height: 1;
  }

  .testimonial-body {
    margin: 0 0 1.75rem 0;
    flex-grow: 1;
  }

  .testimonial-body p {
    font-size: var(--text-base);
    color: var(--color-ink-secondary);
    line-height: 1.7;
    margin: 0;
    font-style: normal;
  }

  /* Author block */
  .testimonial-author {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .author-avatar {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: var(--text-sm);
    flex-shrink: 0;
    border: 1px solid color-mix(in srgb, currentColor 25%, transparent);
  }

  .author-details {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .author-name {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-ink);
    font-style: normal;
    letter-spacing: -0.01em;
  }

  .author-role {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--text-xs);
    color: var(--color-muted);
    flex-wrap: wrap;
  }

  .author-company {
    color: var(--color-ink);
    font-weight: 500;
  }

  .dot-separator {
    color: var(--color-muted-light);
  }

  .project-line {
    font-size: 11px;
    font-family: var(--font-mono);
    color: var(--color-muted);
    margin-top: 0.15rem;
  }

  .project-label {
    color: var(--color-muted-light);
  }

  @media (max-width: 900px) {
    .testimonials-grid {
      grid-template-columns: 1fr;
    }

    .testimonial-card {
      padding: 1.5rem;
    }
  }
</style>
