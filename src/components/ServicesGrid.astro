---
/**
 * ServicesGrid.astro — Services section with bento cards and cursor spotlight.
 */
import { services } from '@/data/services';
---

<section class="section" id="services" aria-labelledby="services-heading">
  <div class="container">
    <div class="section-header" data-reveal>
      <span class="eyebrow">What we do</span>
      <h2 id="services-heading" style="margin-top: 0.75rem; margin-bottom: 1rem;">
        Every layer of your<br/><em>digital stack.</em>
      </h2>
      <p style="max-width: 52ch; color: var(--color-muted);">
        From your first landing page to a full enterprise platform — we cover design,
        engineering, intelligence and growth.
      </p>
    </div>

    <div class="services-grid">
      {services.map((service, i) => (
        <a
          href={`/services/${service.slug}`}
          class="service-card card card-spotlight"
          data-reveal
          data-reveal-delay={String((i % 3) * 100)}
          aria-label={`${service.title} — ${service.shortDescription}`}
        >
          <div class="service-card-top">
            <div class="service-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <circle cx="12" cy="12" r="3"/>
                <path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/>
              </svg>
            </div>
            <span class="service-arrow" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M7 17L17 7M7 7h10v10"/>
              </svg>
            </span>
          </div>

          <h3 class="service-title">{service.title}</h3>
          <p class="service-desc">{service.shortDescription}</p>

          <ul class="service-features">
            {service.subServices.slice(0, 4).map((sub) => (
              <li class="service-feature">
                <span class="service-feature-dot" aria-hidden="true"></span>
                {sub.name}
              </li>
            ))}
          </ul>
        </a>
      ))}
  </div>
</section>

<style>
  .section-header {
    max-width: 56ch;
    margin-bottom: 3rem;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .service-card {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    min-height: 260px;
    transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
  }

  .service-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-glow); border-color: rgba(91,91,240,0.2); }

  .service-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .service-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent-subtle);
    border-radius: var(--radius-sm);
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .service-arrow {
    color: var(--color-muted-light);
    opacity: 0;
    transform: translate(-4px, 4px);
    transition: opacity var(--transition-fast), transform var(--transition-fast);
  }

  .service-card:hover .service-arrow {
    opacity: 1;
    transform: translate(0, 0);
    color: var(--color-accent);
  }

  .service-title {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    color: var(--color-ink);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .service-desc {
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: 1.6;
    flex: 1;
  }

  .service-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: auto;
  }

  .service-feature {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-muted);
  }

  .service-feature-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent);
    flex-shrink: 0;
  }

  .services-cta { text-align: center; }

  @media (max-width: 1024px) {
    .services-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .services-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Cursor-follow spotlight on service cards
  document.querySelectorAll<HTMLElement>('.card-spotlight').forEach((card) => {
    card.addEventListener('mousemove', (e: MouseEvent) => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const rect = card.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width) * 100;
      const y = ((e.clientY - rect.top) / rect.height) * 100;
      card.style.setProperty('--spotlight-x', `${x}%`);
      card.style.setProperty('--spotlight-y', `${y}%`);
    });
  });
</script>
