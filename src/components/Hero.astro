---
/**
 * Hero.astro — Homepage hero with animated headline, gradient background,
 * floating terminal mockup, and lead capture form.
 */
import { site } from "@/data/site";
---

<section class="hero-section" id="hero" aria-label="Hero">
  <!-- Background blobs -->
  <div class="blob blob-1" style="top: -10%; left: -15%;" aria-hidden="true">
  </div>
  <div class="blob blob-2" style="bottom: 10%; right: -10%;" aria-hidden="true">
  </div>

  <div class="container hero-container">
    <!-- Left: headline + CTAs -->
    <div class="hero-content">
      <div class="hero-eyebrow-row" data-reveal>
        <span class="chip chip-accent"
          >Software • Web • Apps • AI • Automation</span
        >
      </div>

      <h1 class="hero-headline">
        <span class="hero-brand-kicker">Moggstack Technologies</span>
        <span class="hero-headline-lines">
          <span class="hero-line" data-hero-line>Solutions</span>
          <span class="hero-line" data-hero-line>built to</span>
          <span class="hero-line" data-hero-line>
            <em class="hero-italic">mog.</em>
          </span>
        </span>
      </h1>

      <p class="hero-sub" data-reveal data-reveal-delay="200">
        We build platforms that move businesses forward: custom websites,
        ERP/CRM solutions, mobile apps, AI integrations and SEO — delivered fast
        and built to scale.
      </p>

      <div class="hero-ctas" data-reveal data-reveal-delay="300">
        <a href="/contact" class="btn btn-primary btn-lg" id="hero-cta-primary">
          Start a project
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>

      <!-- Lead form (compact) -->
      <div class="hero-form-card" data-reveal data-reveal-delay="400">
        <p class="hero-form-label">
          Get a free quote — we reply within 2 hours
        </p>
        <form
          class="hero-form"
          id="hero-lead-form"
          name="contact"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
        >
          <input type="hidden" name="form-name" value="contact" />
          <input type="hidden" name="source" value="hero-lead-form" />
          <input type="hidden" name="subject" value="New quote request from Moggstack Hero" />
          <!-- Honeypot -->
          <p style="display:none;">
            <label>Don't fill this: <input name="bot-field" /></label>
          </p>

          <div class="hero-form-row">
            <div class="form-field">
              <label for="hero-name" class="sr-only">Your name</label>
              <input
                type="text"
                id="hero-name"
                name="name"
                class="form-input"
                placeholder="Your name"
                autocomplete="name"
                required
              />
            </div>
            <div class="form-field">
              <label for="hero-email" class="sr-only">Email address</label>
              <input
                type="email"
                id="hero-email"
                name="email"
                class="form-input"
                placeholder="Email address"
                autocomplete="email"
                required
              />
            </div>
          </div>

          <div class="hero-form-row">
            <div class="form-field">
              <label for="hero-phone" class="sr-only">Phone number</label>
              <input
                type="tel"
                id="hero-phone"
                name="phone"
                class="form-input"
                placeholder="Phone (optional)"
                autocomplete="tel"
              />
            </div>
            <div class="form-field">
              <label for="hero-budget" class="sr-only">Budget range</label>
              <select
                id="hero-budget"
                name="budget"
                class="form-input form-select"
              >
                <option value="" disabled selected>Budget range</option>
                <option value="under-7k">Under ₹7,000</option>
                <option value="7k-15k">₹7,000 – ₹15,000</option>
                <option value="15k-30k">₹15,000 – ₹30,000</option>
                <option value="30k-50k">₹30,000– ₹50,000</option>
                <option value="above-50k">Above ₹50,000</option>
              </select>
            </div>
          </div>

          <div class="form-field">
            <label for="hero-message" class="sr-only"
              >Tell us about your project</label
            >
            <input
              type="text"
              id="hero-message"
              name="message"
              class="form-input"
              placeholder="Tell us about your project (optional)"
            />
          </div>

          <button
            type="submit"
            class="btn btn-primary"
            style="width: 100%; justify-content: center;"
            id="hero-form-submit"
          >
            Request a quote
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M5 12h14M12 5l7 7-7 7"></path>
            </svg>
          </button>

          <div
            id="hero-form-msg"
            role="alert"
            aria-live="polite"
            style="display:none; margin-top: 0.75rem; font-size: var(--text-sm); text-align: center;"
          >
          </div>
        </form>
      </div>
    </div>

    <!-- Right: Terminal / AI chat mockup -->
    <div
      class="hero-visual"
      data-reveal
      data-reveal-delay="500"
      aria-hidden="true"
    >
      <div class="terminal hero-terminal">
        <div class="terminal-header">
          <span class="terminal-dot" style="background: #FF5F57;"></span>
          <span class="terminal-dot" style="background: #FEBC2E;"></span>
          <span class="terminal-dot" style="background: #28C840;"></span>
          <span
            style="margin-left: 0.5rem; font-size: 12px; color: rgba(255,255,255,0.3);"
            >moggstack — build</span
          >
        </div>
        <div class="terminal-body">
          <div class="terminal-line">
            <span class="terminal-prompt">›</span>
            <span id="typed-text" class="typed-output"></span><span
              class="terminal-cursor"></span>
          </div>
          <div class="terminal-output" id="terminal-output"></div>
        </div>
      </div>

      <!-- Stats floating cards -->
      <div class="hero-stat-card hero-stat-1">
        <span class="hero-stat-number"
          >{site.stats[0].value}{site.stats[0].suffix}</span
        >
        <span class="hero-stat-label">{site.stats[0].label}</span>
      </div>
      <div class="hero-stat-card hero-stat-2">
        <span class="hero-stat-number"
          >{site.stats[2].value}{site.stats[2].suffix}</span
        >
        <span class="hero-stat-label">{site.stats[2].label}</span>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="hero-scroll-indicator" aria-hidden="true">
    <div class="scroll-mouse">
      <div class="scroll-dot"></div>
    </div>
    <span>Scroll</span>
  </div>
</section>

<style>
  .hero-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    padding-block: 4rem;
  }

  .hero-eyebrow-row {
    margin-bottom: 1.25rem;
  }

  .hero-headline {
    font-family: var(--font-serif);
    font-size: var(--text-7xl);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    margin-bottom: 1.5rem;
  }

  .hero-brand-kicker {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.875rem;
    line-height: 1.4;
  }

  .hero-headline-lines {
    display: block;
  }

  .hero-line {
    display: block;
    overflow: hidden;
  }

  .hero-line > span,
  .hero-line > em {
    display: block;
    transform: translateY(100%);
    opacity: 0;
    animation: hero-line-reveal 0.8s var(--ease-out-expo) forwards;
  }

  .hero-headline-lines .hero-line:nth-child(1) > *,
  .hero-headline-lines .hero-line:nth-child(1) {
    animation-delay: 0.1s;
  }
  .hero-headline-lines .hero-line:nth-child(2) > *,
  .hero-headline-lines .hero-line:nth-child(2) {
    animation-delay: 0.2s;
  }
  .hero-headline-lines .hero-line:nth-child(3) > *,
  .hero-headline-lines .hero-line:nth-child(3) {
    animation-delay: 0.3s;
  }

  /* Direct children of hero-line need the animation */
  .hero-line {
    transform: translateY(100%);
    opacity: 0;
    animation: hero-line-reveal 0.85s var(--ease-out-expo) forwards;
  }

  @keyframes hero-line-reveal {
    from {
      transform: translateY(30px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .hero-italic {
    font-style: italic;
    background: var(--gradient-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-sub {
    font-size: var(--text-lg);
    color: var(--color-ink-secondary);
    line-height: 1.65;
    max-width: 48ch;
    margin-bottom: 2rem;
  }

  .hero-ctas {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  /* Lead form card */
  .hero-form-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
  }

  .hero-form-label {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-muted);
    margin-bottom: 0.875rem;
  }

  .hero-form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .hero-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }

  /* Visual panel */
  .hero-visual {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    animation: float 6s ease-in-out infinite;
  }

  .hero-terminal {
    width: 100%;
    max-width: 440px;
  }

  /* Floating stat cards */
  .hero-stat-card {
    position: absolute;
    background: rgba(250, 249, 246, 0.9);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.75rem 1rem;
    backdrop-filter: blur(12px);
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    box-shadow: var(--shadow-md);
  }

  [data-theme="dark"] .hero-stat-card {
    background: rgba(19, 19, 22, 0.9);
  }

  .hero-stat-1 {
    left: -2rem;
    bottom: 2rem;
    animation: float 5s 1s ease-in-out infinite;
  }
  .hero-stat-2 {
    right: -1rem;
    top: 2rem;
    animation: float 7s 0.5s ease-in-out infinite;
  }

  .hero-stat-number {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    color: var(--color-ink);
    line-height: 1;
  }

  .hero-stat-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
    white-space: nowrap;
  }

  /* Scroll indicator */
  .hero-scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted-light);
    animation: fade-in 1s 1.5s both;
  }

  .scroll-mouse {
    width: 22px;
    height: 34px;
    border: 1.5px solid currentColor;
    border-radius: 12px;
    display: flex;
    justify-content: center;
    padding-top: 6px;
  }

  .scroll-dot {
    width: 4px;
    height: 6px;
    background: currentColor;
    border-radius: 2px;
    animation: scroll-dot 1.5s ease-in-out infinite;
  }

  @keyframes scroll-dot {
    0%,
    100% {
      transform: translateY(0);
      opacity: 1;
    }
    50% {
      transform: translateY(8px);
      opacity: 0.3;
    }
  }

  @media (max-width: 1024px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .hero-visual {
      display: none;
    }
    .hero-form-row {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .hero-headline {
      font-size: var(--text-6xl);
    }
    .hero-ctas {
      flex-direction: column;
    }
    .hero-ctas .btn {
      justify-content: center;
    }
    .hero-scroll-indicator {
      display: none;
    }
  }
</style>

<script>
  // ── Terminal typing effect ──────────────────────────────────────
  const typedEl = document.getElementById("typed-text");
  const outputEl = document.getElementById("terminal-output");

  const lines = [
    { cmd: "npx create-moggstack-project ./", delay: 0 },
    {
      cmd: "✓ Analysing requirements...",
      delay: 1200,
      output: true,
      color: "#5B5BF0",
    },
    {
      cmd: "✓ Design blueprint ready",
      delay: 2200,
      output: true,
      color: "#28C840",
    },
    {
      cmd: "✓ Building components...",
      delay: 3000,
      output: true,
      color: "#28C840",
    },
    {
      cmd: "✓ SEO & performance audited",
      delay: 3800,
      output: true,
      color: "#28C840",
    },
    {
      cmd: "🚀 Launched at moggstack.in",
      delay: 4600,
      output: true,
      color: "#FEBC2E",
    },
  ];

  let currentLine = 0;
  let currentChar = 0;
  let isTyping = true;

  function typeChar() {
    if (!typedEl || !outputEl) return;
    const line = lines[currentLine];
    if (!line) return;

    if (currentChar < line.cmd.length) {
      typedEl.textContent = line.cmd.slice(0, currentChar + 1);
      currentChar++;
      setTimeout(typeChar, 45);
    } else {
      // Line complete — push to output if it's a response line
      if (line.output && outputEl) {
        const div = document.createElement("div");
        div.className = "terminal-line";
        div.style.color = line.color || "rgba(255,255,255,0.7)";
        div.textContent = line.cmd;
        div.style.animationDelay = "0ms";
        div.style.animation = "fade-in 0.3s ease";
        outputEl.appendChild(div);
        typedEl.textContent = "";
      }

      // Move to next line
      currentChar = 0;
      currentLine++;
      if (currentLine < lines.length) {
        const nextLine = lines[currentLine];
        const delay = nextLine.delay - lines[currentLine - 1].delay;
        setTimeout(
          () => {
            if (!nextLine.output) {
              typedEl.textContent = "";
            }
            typeChar();
          },
          Math.max(delay, 500),
        );
      } else {
        // Reset after pause
        setTimeout(() => {
          if (outputEl) outputEl.innerHTML = "";
          if (typedEl) typedEl.textContent = "";
          currentLine = 0;
          currentChar = 0;
          typeChar();
        }, 3000);
      }
    }
  }

  // Start typing after a brief delay
  setTimeout(typeChar, 800);

  // ── Magnetic CTA buttons ────────────────────────────────────────
  function initMagnetic() {
    const magneticBtns = document.querySelectorAll("#hero-cta-primary");

    magneticBtns.forEach((btn) => {
      btn.addEventListener("mousemove", (e: Event) => {
        const mouseEvent = e as MouseEvent;
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
          return;
        const rect = (btn as HTMLElement).getBoundingClientRect();
        const x = mouseEvent.clientX - rect.left - rect.width / 2;
        const y = mouseEvent.clientY - rect.top - rect.height / 2;
        (btn as HTMLElement).style.transform =
          `translate(${x * 0.15}px, ${y * 0.15}px)`;
      });

      btn.addEventListener("mouseleave", () => {
        (btn as HTMLElement).style.transform = "";
      });
    });
  }

  initMagnetic();

  // ── Lead form submit ────────────────────────────────────────────
  const heroForm = document.getElementById("hero-lead-form") as HTMLFormElement;
  const heroFormMsg = document.getElementById("hero-form-msg");
  const heroFormSubmit = document.getElementById(
    "hero-form-submit",
  ) as HTMLButtonElement;

  heroForm?.addEventListener("submit", async (e) => {
    e.preventDefault();

    // Honeypot check
    const botField = heroForm.querySelector<HTMLInputElement>(
      'input[name="bot-field"]',
    );
    if (botField?.value) return;

    const name = (document.getElementById("hero-name") as HTMLInputElement)?.value?.trim();
    const email = (document.getElementById("hero-email") as HTMLInputElement)?.value?.trim();

    if (!name || !email) {
      if (heroFormMsg) {
        heroFormMsg.style.display = "block";
        heroFormMsg.style.color = "var(--color-accent-2)";
        heroFormMsg.textContent = "Please enter your name and email.";
      }
      return;
    }

    heroFormSubmit.disabled = true;
    heroFormSubmit.textContent = "Sending...";

    const formData = new FormData(heroForm);

    try {
      const res = await fetch("/", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: new URLSearchParams(formData as any).toString(),
      });

      if (res.ok) {
        if (heroFormMsg) {
          heroFormMsg.style.display = "block";
          heroFormMsg.style.color = "#28C840";
          heroFormMsg.textContent =
            "✓ Received! We'll be in touch within 2 hours.";
        }
        heroForm.reset();
      } else {
        throw new Error("Server error");
      }
    } catch {
      if (heroFormMsg) {
        heroFormMsg.style.display = "block";
        heroFormMsg.style.color = "var(--color-accent-2)";
        heroFormMsg.textContent =
          "Something went wrong. Please email us directly at adhnanck07@gmail.com.";
      }
    } finally {
      heroFormSubmit.disabled = false;
      heroFormSubmit.textContent = "Request a quote";
    }
  });
</script>
