---
/**
 * SolutionsTeaser.astro — Solutions preview strip for the homepage.
 * Full page at /solutions.
 */
import { solutions } from '@/data/solutions';

const teaserSolutions = solutions.slice(0, 6);
---

<section class="section" id="solutions" aria-labelledby="solutions-heading">
  <div class="container">
    <div class="section-header" data-reveal>
      <span class="eyebrow">What we build</span>
      <h2 id="solutions-heading" style="margin-top: 0.75rem; margin-bottom: 1rem;">
        Platforms built for<br/><em>real industries.</em>
      </h2>
      <p style="max-width: 52ch; color: var(--color-muted);">
        These aren't templates — they're complex, custom-engineered platforms we build from scratch.
        Each one solves a real operational problem.
      </p>
    </div>

    <div class="solutions-grid">
      {teaserSolutions.map((solution, i) => (
        <a
          href={`/solutions#${solution.slug}`}
          class="solution-card"
          style={`--accent: ${solution.accentColor};`}
          data-reveal
          data-reveal-delay={String((i % 3) * 100)}
          aria-label={`${solution.title}: ${solution.shortDescription}`}
        >
          <div class="solution-card-header">
            <div class="solution-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
              </svg>
            </div>
            <span class="solution-category chip">{solution.category}</span>
          </div>

          <h3 class="solution-title">{solution.title}</h3>
          <p class="solution-desc">{solution.shortDescription}</p>

          <div class="solution-benefits">
            {solution.benefits.slice(0, 3).map((b) => (
              <div class="solution-benefit">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                </svg>
                <span>{b.title}</span>
              </div>
            ))}
          </div>

          <span class="solution-learn">
            Explore platform
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M7 17L17 7M7 7h10v10"/>
            </svg>
          </span>
        </a>
      ))}
  </div>
</section>

<style>
  .solutions-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .solution-card {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--gradient-card);
    text-decoration: none;
    color: inherit;
    transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
    position: relative;
    overflow: hidden;
  }

  .solution-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--transition-base);
  }

  .solution-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 48px rgba(0,0,0,0.08);
    border-color: var(--color-border-strong);
  }

  .solution-card:hover::before { transform: scaleX(1); }

  .solution-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .solution-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
  }

  .solution-category {
    font-size: 10px;
    background: var(--color-surface);
    color: var(--color-muted);
  }

  .solution-title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    color: var(--color-ink);
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .solution-desc {
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: 1.6;
    flex: 1;
  }

  .solution-benefits {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .solution-benefit {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-xs);
    color: var(--color-ink-secondary);
  }

  .solution-benefit svg { color: var(--accent); flex-shrink: 0; }

  .solution-learn {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--accent);
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
    opacity: 0;
    transform: translateY(4px);
    transition: opacity var(--transition-fast), transform var(--transition-fast);
  }

  .solution-card:hover .solution-learn {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 1024px) {
    .solutions-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .solutions-grid { grid-template-columns: 1fr; }
  }
</style>
