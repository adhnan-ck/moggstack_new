---
/**
 * WorkShowcase.astro — Featured project portfolio cards replacing the old industries section.
 */

const projects = [
  {
    id: 'ambrograde',
    name: 'Ambrograde',
    category: 'Fashion & E-Commerce',
    image: '/work/ambrograde.jpg',
    tagline: 'Premium streetwear for dreamers, creators, and doers.',
    description:
      "A full-fledged e-commerce experience for a premium clothing brand. Built with Framer and cutting-edge motion design to deliver cinematic page transitions, scroll-driven animations, and a bold editorial aesthetic that matches the brand's identity.",
    tags: ['Framer', 'Motion Design', 'E-Commerce', 'UI/UX'],
    accentColor: '#f59e0b',
  },
  {
    id: 'ahalya-catering',
    name: 'Ahalya Catering',
    category: 'Food & Hospitality',
    image: '/work/ahalya-catering.jpg',
    tagline: 'Flavors for every celebration.',
    description:
      'A refined landing page for a premium catering service. Designed to convert enquiries for weddings, corporate events, private parties and traditional feasts — with an elegant dark-gold aesthetic, custom menu exploration and a seamless booking call-to-action.',
    tags: ['Landing Page', 'Brand Design', 'Conversion CRO', 'Astro'],
    accentColor: '#d97706',
  },
  {
    id: 'ai-integration',
    name: 'AI Invoice Automation',
    category: 'AI & Automation',
    image: '/work/ai-integration.jpg',
    tagline: 'Intelligent document processing, end-to-end.',
    description:
      'End-to-end AI pipeline built for a company to automate invoice and document workflows. Emails with attachments (invoices, receipts, PDFs) are captured via GCP, fed into Gemini for intelligent extraction, and returned as structured JSON — eliminating manual data entry. Includes a RAG-powered chatbot for querying historical records.',
    tags: ['GCP', 'Gemini AI', 'RAG Bot', 'Document AI', 'Python'],
    accentColor: '#6366f1',
  },
];
---

<section class="section work-section" id="our-work" aria-labelledby="work-heading">
  <div class="container">
    <div class="section-header" data-reveal>
      <span class="eyebrow">Our Work</span>
      <h2 id="work-heading" style="margin-top: 0.75rem; margin-bottom: 1rem;">
        Projects we're<br /><em>proud to ship.</em>
      </h2>
      <p style="max-width: 54ch; color: var(--color-muted);">
        A glimpse into what we build — real products for real clients, delivered with precision and purpose.
      </p>
    </div>

    <div class="work-grid">
      {projects.map((project, i) => (
        <article
          class="work-card"
          style={`--project-accent: ${project.accentColor};`}
          data-reveal
          data-reveal-delay={String((i % 3) * 120)}
        >
          <!-- Image -->
          <div class="work-card-image-wrap">
            <img
              src={project.image}
              alt={`${project.name} project screenshot`}
              class="work-card-image"
              loading="lazy"
              decoding="async"
            />
            <div class="work-card-overlay">
              <span class="work-category-badge">{project.category}</span>
            </div>
          </div>

          <!-- Body -->
          <div class="work-card-body">
            <div class="work-card-meta">
              <h3 class="work-card-title">{project.name}</h3>
              <span class="work-card-tagline">{project.tagline}</span>
            </div>

            <p class="work-card-desc">{project.description}</p>

            <div class="work-card-tags">
              {project.tags.map((tag) => (
                <span class="work-tag">{tag}</span>
              ))}
            </div>
          </div>

          <!-- Accent bar -->
          <div class="work-card-accent-bar" aria-hidden="true" />
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .work-section {
    border-top: 1px solid var(--color-border);
  }

  /* Grid */
  .work-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 3rem;
  }

  /* Card */
  .work-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl, 1rem);
    background: var(--gradient-card);
    overflow: hidden;
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.25s ease;
  }

  .work-card:hover {
    transform: translateY(-6px);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--project-accent) 30%, transparent),
      0 24px 56px rgba(0, 0, 0, 0.12);
    border-color: color-mix(in srgb, var(--project-accent) 40%, transparent);
  }

  /* Accent bar (top) */
  .work-card-accent-bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(
      90deg,
      var(--project-accent),
      color-mix(in srgb, var(--project-accent) 50%, transparent)
    );
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .work-card:hover .work-card-accent-bar {
    transform: scaleX(1);
  }

  /* Image */
  .work-card-image-wrap {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-surface);
  }

  .work-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    display: block;
  }

  .work-card:hover .work-card-image {
    transform: scale(1.04);
  }

  .work-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 50%,
      rgba(0, 0, 0, 0.55) 100%
    );
    display: flex;
    align-items: flex-end;
    padding: 1rem;
    pointer-events: none;
  }

  .work-category-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.75rem;
    background: color-mix(in srgb, var(--project-accent) 20%, rgba(0, 0, 0, 0.5));
    border: 1px solid color-mix(in srgb, var(--project-accent) 60%, transparent);
    border-radius: 999px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: #fff;
    backdrop-filter: blur(8px);
  }

  /* Body */
  .work-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding: 1.5rem;
    flex: 1;
  }

  .work-card-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .work-card-title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-ink);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .work-card-tagline {
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--project-accent);
    line-height: 1.4;
    font-weight: 500;
  }

  .work-card-desc {
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: 1.7;
    flex: 1;
  }

  /* Tags */
  .work-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
  }

  .work-tag {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-ink-secondary);
    background: var(--color-surface);
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }

  .work-card:hover .work-tag {
    border-color: color-mix(in srgb, var(--project-accent) 35%, transparent);
    color: var(--project-accent);
    background: color-mix(in srgb, var(--project-accent) 8%, transparent);
  }

  /* Responsive */
  @media (max-width: 1100px) {
    .work-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .work-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
