---
/**
 * CTASection.astro — Final CTA section.
 * Reusable across pages; accepts custom headline/button.
 */
import { site } from "@/data/site";

interface Props {
  headline?: string;
  sub?: string;
  primaryCta?: string;
  primaryHref?: string;
  showMiniForm?: boolean;
}

const {
  headline = "Ready to build your next big idea?",
  sub = "Let's talk about what you're building. We respond within 2 hours.",
  primaryCta = "Let's connect",
  primaryHref = "/contact",
  showMiniForm = false,
} = Astro.props;
---

<section class="cta-section section" aria-labelledby="cta-heading">
  <div
    class="cta-blob blob blob-1"
    style="top: -30%; right: -10%;"
    aria-hidden="true"
  >
  </div>
  <div
    class="cta-blob blob blob-2"
    style="bottom: -20%; left: -5%;"
    aria-hidden="true"
  >
  </div>

  <div class="container">
    <div class="cta-inner" data-reveal>
      <div class="cta-text">
        <span class="eyebrow">Get started</span>
        <h2
          id="cta-heading"
          style="margin-top: 0.75rem; margin-bottom: 1rem; max-width: 18ch;"
        >
          {headline}
        </h2>
        <p style="color: var(--color-muted); max-width: 40ch;">{sub}</p>
      </div>

      {
        showMiniForm ? (
          <form
            class="cta-mini-form"
            id="cta-contact-form"
            name="contact"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
          >
            <input type="hidden" name="form-name" value="contact" />
            <input type="hidden" name="source" value="cta-contact-form" />
            <input type="hidden" name="subject" value="New inquiry from Moggstack CTA section" />
            <p style="display:none;">
              <label>Don't fill this: <input name="bot-field" /></label>
            </p>
            <div class="cta-form-row">
              <div class="form-field">
                <label for="cta-name" class="sr-only">
                  Name
                </label>
                <input
                  type="text"
                  id="cta-name"
                  name="name"
                  class="form-input"
                  placeholder="Your name"
                  required
                />
              </div>
              <div class="form-field">
                <label for="cta-email" class="sr-only">
                  Email
                </label>
                <input
                  type="email"
                  id="cta-email"
                  name="email"
                  class="form-input"
                  placeholder="Email address"
                  required
                />
              </div>
            </div>
            <div class="form-field">
              <label for="cta-budget2" class="sr-only">
                Budget
              </label>
              <select
                id="cta-budget2"
                name="budget"
                class="form-input form-select"
              >
                <option value="" disabled selected>
                  Budget range (optional)
                </option>
                <option value="" disabled selected>
                  Budget range
                </option>
                <option value="under-7k">under ₹7,000</option>
                <option value="5k-15k">₹7,000 – ₹15,000</option>
                <option value="15k-30k">₹15,000 – ₹30,000</option>
                <option value="30k-50k">₹30,000– ₹50,000</option>
                <option value="above-50k">Above ₹50,000</option>
              </select>
            </div>
            <div class="form-field">
              <label for="cta-message2" class="sr-only">
                Message
              </label>
              <textarea
                id="cta-message2"
                name="message"
                class="form-input form-textarea"
                placeholder="Tell us what you're building..."
                rows="3"
              />
            </div>
            <div class="cta-form-actions">
              <button type="submit" class="btn btn-primary btn-lg" id="cta-form-submit">
                Send message
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </button>
              <a
                href={`https://wa.me/${site.whatsapp}?text=${site.whatsappMessage}`}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-outline btn-lg"
              >
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
                </svg>
                WhatsApp us
              </a>
            </div>
            <p id="cta-form-msg" style="display:none; font-size: var(--text-sm); margin-top: 0.5rem;"></p>
          </form>
        ) : (
          <div class="cta-buttons">
            <a href={primaryHref} class="btn btn-primary btn-xl">
              {primaryCta}
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
            <a
              href={`https://wa.me/${site.whatsapp}?text=${site.whatsappMessage}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-outline btn-xl"
            >
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
              </svg>
              Chat on WhatsApp
            </a>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .cta-section {
    position: relative;
    overflow: hidden;
    background: var(--gradient-hero);
    border-top: 1px solid var(--color-border);
  }

  .cta-blob {
    position: absolute;
    pointer-events: none;
  }

  .cta-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .cta-text h2 {
    font-size: var(--text-5xl);
  }

  .cta-buttons {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 320px;
  }

  .cta-mini-form {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
  }

  .cta-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.625rem;
  }

  .cta-form-actions {
    display: flex;
    gap: 0.625rem;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }

  @media (max-width: 768px) {
    .cta-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .cta-form-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const ctaForm = document.getElementById("cta-contact-form") as HTMLFormElement;
  const ctaFormMsg = document.getElementById("cta-form-msg");
  const ctaFormSubmit = document.getElementById("cta-form-submit") as HTMLButtonElement;

  ctaForm?.addEventListener("submit", async (e) => {
    e.preventDefault();

    const botField = ctaForm.querySelector<HTMLInputElement>('input[name="bot-field"]');
    if (botField?.value) return;

    const name = (document.getElementById("cta-name") as HTMLInputElement)?.value?.trim();
    const email = (document.getElementById("cta-email") as HTMLInputElement)?.value?.trim();

    if (!name || !email) {
      if (ctaFormMsg) {
        ctaFormMsg.style.display = "block";
        ctaFormMsg.style.color = "var(--color-accent-2)";
        ctaFormMsg.textContent = "Please enter your name and email.";
      }
      return;
    }

    if (ctaFormSubmit) {
      ctaFormSubmit.disabled = true;
      ctaFormSubmit.textContent = "Sending...";
    }

    const formData = new FormData(ctaForm);

    try {
      const res = await fetch("/", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: new URLSearchParams(formData as any).toString(),
      });

      if (res.ok) {
        if (ctaFormMsg) {
          ctaFormMsg.style.display = "block";
          ctaFormMsg.style.color = "#28C840";
          ctaFormMsg.textContent = "✓ Received! We'll be in touch within 2 hours.";
        }
        ctaForm.reset();
      } else {
        throw new Error("Server error");
      }
    } catch {
      if (ctaFormMsg) {
        ctaFormMsg.style.display = "block";
        ctaFormMsg.style.color = "var(--color-accent-2)";
        ctaFormMsg.textContent = "Something went wrong. Please email us directly at adhnanck07@gmail.com.";
      }
    } finally {
      if (ctaFormSubmit) {
        ctaFormSubmit.disabled = false;
        ctaFormSubmit.textContent = "Send message";
      }
    }
  });
</script>
