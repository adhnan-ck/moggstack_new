---
/**
 * Footer.astro — Full-featured site footer.
 */
import { site } from '@/data/site';

const currentYear = new Date().getFullYear();

const footerCompany = [
  { label: 'Home', href: '/' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'About', href: '/about' },
  { label: 'Work', href: '/work' },
  { label: 'Blog', href: '/blog' },
  { label: 'Contact', href: '/contact' },
];

const footerLegal = [
  { label: 'Privacy Policy', href: '/privacy-policy' },
  { label: 'Terms & Conditions', href: '/terms-and-conditions' },
  { label: 'Cookie Policy', href: '/cookie-policy' },
  { label: 'Refund Policy', href: '/refund-and-cancellation' },
  { label: 'Accessibility', href: '/accessibility' },
];
---

<footer class="footer">
  <!-- Newsletter / CTA strip -->
  <div class="footer-cta-strip">
    <div class="container">
      <div class="footer-cta-inner">
        <div>
          <h2 class="footer-cta-heading">Ready to build something great?</h2>
          <p style="color: var(--color-muted-light); font-size: var(--text-sm);">Join businesses that chose to mog.</p>
        </div>
        <div class="footer-newsletter">
          <form class="newsletter-form" onsubmit="return false;">
            <label for="newsletter-email" class="sr-only">Email address</label>
            <input
              type="email"
              id="newsletter-email"
              name="email"
              class="form-input newsletter-input"
              placeholder="your@email.com"
              autocomplete="email"
            />
            <button type="submit" class="btn btn-primary btn-sm">Subscribe</button>
          </form>
          <p style="font-size: var(--text-xs); color: var(--color-muted-light); margin-top: 0.5rem;">
            No spam. Unsubscribe anytime.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Main footer -->
  <div class="footer-main">
    <div class="container">
      <div class="footer-grid">

        <!-- Brand column -->
        <div class="footer-brand">
          <a href="/" class="footer-logo" aria-label="Moggstack Technologies">
            <svg width="140" height="32" viewBox="0 0 140 32" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="0" y="6" width="20" height="20" rx="5" fill="var(--color-accent)" opacity="0.2"/>
              <text x="3" y="22" font-family="Instrument Serif, serif" font-size="18" fill="var(--color-accent)">M</text>
              <text x="26" y="22" font-family="Instrument Serif, serif" font-size="17" fill="currentColor" letter-spacing="-0.02em">Moggstack</text>
            </svg>
          </a>
          <p class="footer-blurb">
            We design and build fast, modern websites, apps and AI solutions that help businesses grow — delivered with clarity, built to scale.
          </p>
          <!-- Socials -->
          <div class="footer-socials">
            <a href={site.socials.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="social-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z"/>
                <circle cx="4" cy="4" r="2"/>
              </svg>
            </a>
            <a href={site.socials.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="social-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                <path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
              </svg>
            </a>
            <a href={site.socials.twitter} target="_blank" rel="noopener noreferrer" aria-label="X / Twitter" class="social-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>
            <a href={site.socials.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="social-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M22.54 6.42a2.78 2.78 0 00-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 00-1.95 1.96A29 29 0 001 12a29 29 0 00.46 5.58 2.78 2.78 0 001.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 001.95-1.96A29 29 0 0023 12a29 29 0 00-.46-5.58z"/>
                <polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="#fff"/>
              </svg>
            </a>
            <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="social-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Quick Links -->
        <div class="footer-col">
          <h3 class="footer-col-heading">Pages</h3>
          <ul role="list">
            {footerCompany.map((link) => (
              <li><a href={link.href} class="footer-link">{link.label}</a></li>
            ))}
          </ul>
        </div>

        <!-- Legal -->
        <div class="footer-col">
          <h3 class="footer-col-heading">Legal</h3>
          <ul role="list">
            {footerLegal.map((link) => (
              <li><a href={link.href} class="footer-link">{link.label}</a></li>
            ))}
          </ul>
        </div>

        <!-- Contact -->
        <div class="footer-col">
          <h3 class="footer-col-heading">Contact</h3>
          <address class="footer-address">
            <a href={`mailto:${site.email}`} class="footer-contact-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              {site.email}
            </a>
            <a href={`tel:${site.phoneRaw}`} class="footer-contact-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 10.8a19.79 19.79 0 01-3.07-8.67A2 2 0 012 .18h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
              {site.phone}
            </a>
            <a href={`https://wa.me/${site.whatsapp.replace(/\D/g, '')}?text=${site.whatsappMessage}`} target="_blank" rel="noopener noreferrer" class="footer-contact-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
              WhatsApp (+91 99953 38177)
            </a>
            <span class="footer-contact-item" style="cursor: default;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              {site.workingHours}
            </span>
          </address>
        </div>

      </div>

      <!-- Bottom bar -->
      <div class="footer-bottom">
        <p class="footer-copyright">
          © {currentYear} Moggstack Technologies. All rights reserved.
        </p>
        <p style="font-size: var(--text-xs); color: var(--color-muted-light);">
          Built with Astro · Made in India 🇮🇳
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
  }

  .footer-cta-strip {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding-block: 2rem;
  }

  .footer-cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .footer-cta-heading {
    font-size: var(--text-2xl);
    color: var(--color-ink);
    margin-bottom: 0.25rem;
  }

  .footer-newsletter { min-width: 280px; }

  .newsletter-form {
    display: flex;
    gap: 0.5rem;
  }

  .newsletter-input {
    flex: 1;
    min-width: 0;
  }

  .footer-main {
    padding-block: 3rem 1.5rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.8fr 1fr 1fr 1.4fr;
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .footer-logo { color: var(--color-ink); display: inline-block; margin-bottom: 1rem; }

  .footer-blurb {
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: 1.65;
    margin-bottom: 1.25rem;
    max-width: 28ch;
  }

  .footer-socials {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-muted);
    transition: background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
    text-decoration: none;
  }

  .social-icon:hover {
    background: var(--color-accent-subtle);
    color: var(--color-accent);
    border-color: rgba(91,91,240,0.2);
  }

  .footer-col-heading {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    margin-bottom: 0.875rem;
  }

  .footer-col ul { list-style: none; }
  .footer-col li { margin-bottom: 0.5rem; }

  .footer-link {
    font-size: var(--text-sm);
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-link:hover { color: var(--color-ink); }

  .footer-address { font-style: normal; }

  .footer-contact-item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin-bottom: 0.625rem;
    text-decoration: none;
    transition: color var(--transition-fast);
    line-height: 1.5;
  }

  .footer-contact-item svg { flex-shrink: 0; margin-top: 2px; }

  a.footer-contact-item:hover { color: var(--color-accent); }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .footer-copyright {
    font-size: var(--text-xs);
    color: var(--color-muted-light);
  }

  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .footer-brand { grid-column: 1 / -1; }
    .footer-cta-inner { flex-direction: column; align-items: flex-start; }
  }

  @media (max-width: 640px) {
    .footer-grid { grid-template-columns: repeat(2, 1fr); gap: 2rem; }
  }

  @media (max-width: 480px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>
