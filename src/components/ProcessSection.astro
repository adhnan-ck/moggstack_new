---
/**
 * ProcessSection.astro — 8-step process.
 * Desktop: horizontal scroll pinned section.
 * Mobile: vertical timeline.
 */
import { processSteps } from '@/data/process';
---

<section class="section process-section" id="process" aria-labelledby="process-heading">
  <div class="container">
    <div class="section-header" data-reveal>
      <span class="eyebrow">How we work</span>
      <h2 id="process-heading" style="margin-top: 0.75rem; margin-bottom: 1rem;">
        From idea to<br/><em>launch-ready.</em>
      </h2>
      <p style="max-width: 48ch; color: var(--color-muted);">
        A proven 8-step process that eliminates surprises and keeps every project on time and on scope.
      </p>
    </div>
  </div>

  <!-- Horizontal scroll on desktop -->
  <div class="process-scroll-container hide-mobile" aria-label="Process steps">
    <div class="process-track" id="process-track">
      {processSteps.map((step) => (
        <div class="process-step-card">
          <div class="process-step-header">
            <span class="step-number">{step.stepLabel}</span>
            <div class="process-step-line" aria-hidden="true"></div>
          </div>
          <h3 class="process-step-title">{step.title}</h3>
          <p class="process-step-desc">{step.description}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- Vertical timeline on mobile -->
  <div class="process-timeline hide-desktop container">
    {processSteps.map((step, i) => (
      <div class="timeline-item" data-reveal data-reveal-delay={String((i % 2) * 150)}>
        <div class="timeline-marker">
          <div class="timeline-dot"></div>
          {i < processSteps.length - 1 && <div class="timeline-line"></div>}
        </div>
        <div class="timeline-content">
          <span class="step-number">{step.stepLabel}</span>
          <h3 class="timeline-title">{step.title}</h3>
          <p class="timeline-desc">{step.description}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .process-section { overflow: hidden; }

  /* Horizontal scroll track */
  .process-scroll-container {
    overflow-x: auto;
    overflow-y: visible;
    padding: 3rem 0 2rem;
    cursor: grab;
    scrollbar-width: thin;
    scrollbar-color: var(--color-border-strong) transparent;
    -webkit-overflow-scrolling: touch;
  }
  .process-scroll-container:active { cursor: grabbing; }

  .process-track {
    display: flex;
    gap: 0;
    padding-inline: clamp(1rem, 5vw, 4rem);
    width: max-content;
  }

  .process-step-card {
    flex-shrink: 0;
    width: 280px;
    padding: 0 2rem 0 0;
    position: relative;
  }

  .process-step-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .process-step-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, var(--color-accent), var(--color-border));
    opacity: 0.4;
  }

  .process-step-card:last-child .process-step-line {
    display: none;
  }

  .process-step-title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    color: var(--color-ink);
    margin-bottom: 0.625rem;
    letter-spacing: -0.02em;
  }

  .process-step-desc {
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: 1.65;
  }

  /* Vertical timeline (mobile) */
  .process-timeline { display: flex; flex-direction: column; }

  .timeline-item {
    display: flex;
    gap: 1.25rem;
    padding-bottom: 2rem;
  }

  .timeline-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    padding-top: 4px;
  }

  .timeline-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 3px var(--color-accent-subtle);
    flex-shrink: 0;
  }

  .timeline-line {
    width: 1px;
    flex: 1;
    background: var(--color-border);
    margin-top: 8px;
    min-height: 40px;
  }

  .timeline-title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    color: var(--color-ink);
    margin: 0.375rem 0 0.5rem;
    letter-spacing: -0.02em;
  }

  .timeline-desc {
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: 1.65;
  }
</style>

<script>
  // Drag-to-scroll on the horizontal process track
  const container = document.querySelector<HTMLElement>('.process-scroll-container');
  if (container) {
    let isDown = false;
    let startX = 0;
    let scrollLeft = 0;

    container.addEventListener('mousedown', (e) => {
      isDown = true;
      container.classList.add('active');
      startX = e.pageX - container.offsetLeft;
      scrollLeft = container.scrollLeft;
    });

    container.addEventListener('mouseleave', () => { isDown = false; container.classList.remove('active'); });
    container.addEventListener('mouseup', () => { isDown = false; container.classList.remove('active'); });

    container.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - container.offsetLeft;
      const walk = (x - startX) * 1.5;
      container.scrollLeft = scrollLeft - walk;
    });
  }
</script>
