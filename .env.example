# Moggstack Technologies — Environment Variables
# Copy this file to .env and fill in the values before deploying.

# ─────────────────────────────────────────────
# Email (Resend) — required for /api/contact
# ─────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
CONTACT_EMAIL=adhnanck07@gmail.com          # where form submissions land

# ─────────────────────────────────────────────
# Analytics (optional — set to enable)
# ─────────────────────────────────────────────
# GA4
PUBLIC_GA4_ID=G-XXXXXXXXXX
# Plausible
PUBLIC_PLAUSIBLE_DOMAIN=moggstack.com

# ─────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────
PUBLIC_SITE_URL=https://moggstack.com
